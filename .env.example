# Supabase (Free plan): database + auth only. No Storage is used.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by server actions and the worker. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2: full matches, clips and highlight reels. Private bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=soccer-videos
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Worker: keep the full match in R2 after processing so new clips can be cut later.
# Set to "true" to delete originals once clips + reel exist (saves storage, ~$0.015/GB-month).
DELETE_SOURCE_AFTER_PROCESSING=false
PASSWORD_DB=Jaamnrasjn82*
