# Supabase (Free plan): database + auth only. No Storage is used.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by server actions and the worker. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2: full matches, clips and highlight reels. Private bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=soccer-videos
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Worker: delete the full match from R2 once clips + reel are generated
# (keeps the bucket inside R2's free 10 GB). Set to "false" to keep originals.
DELETE_SOURCE_AFTER_PROCESSING=true
PASSWORD_DB=Jaamnrasjn82*
